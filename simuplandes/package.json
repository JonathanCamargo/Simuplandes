    "@mui/material": "^5.18.0",
    "browser-fs-access": "^0.38.0",
    "cmdk": "^1.1.1",
    "i18next": "^26.4.2",
    "immer": "^11.1.18",
    "konva": "^9.3.5",
    "matter-js": "^0.19.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hotkeys-hook": "^5.3.3",
    "react-i18next": "^17.0.15",
    "react-konva": "~18.2.16",
    "react-resizable-panels": "^4.13.3",
    "react-router": "^6.22.2",
    "react-router-dom": "^6.22.2",
    "uplot": "^1.6.32",
    "uuid": "^9.0.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
