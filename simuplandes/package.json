  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke-dev.mjs",
    "fixtures:curves": "tsx scripts/gen-curves.ts",
    "fixtures:exports": "tsx scripts/gen-graphthe-exports.ts",
    "fixtures:sync": "node scripts/sync-dms-fixtures.mjs",
    "fixtures:sync:graphthe": "node scripts/sync-graphthe-fixtures.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@fontsource/roboto": "^5.3.0",
